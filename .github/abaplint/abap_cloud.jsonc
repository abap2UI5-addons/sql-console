{
  "global": {
    "files": "/../../src/**/*.*",
    // src/native, the native SQL console (ADBC, derived from ZTOAD), is
    // Standard ABAP only by design: ABAP Cloud forbids EXEC SQL and releases
    // neither ADBC (cl_sql_statement, cx_sql_exception) nor the DDIC and ADT
    // internals the package reads (if_dd_sobject, cl_dd_ddl_handler_factory,
    // dd03p, if_data_preview, ...). abap-standard lints it with abaplint.jsonc;
    // this check keeps covering src/abap, the Open SQL console, which is the
    // part that runs on ABAP Cloud.
    "exclude": ["/src/native/"]
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5-addons/popups",
      "folder": "/popups",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5-addons/custom-controls",
      "folder": "/customcontrols",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "Cloud",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
